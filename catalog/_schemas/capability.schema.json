{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pm-kit capability registry",
  "description": "capabilities/registry.json 的格式。kind 是开放的分类标签，不驱动加载——决定 instruction 与资源基准的是 resource_base，所以新增一种能力类型不需要改 schema。",
  "type": "object",
  "required": ["schema_version", "capabilities"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "description": { "type": "string" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "resource_base", "instruction", "when", "accepts", "produces"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "kind": { "type": "string", "minLength": 1 },
          "resource_base": { "type": "string", "minLength": 1 },
          "instruction": { "type": "string", "minLength": 1 },
          "when": { "type": "string", "minLength": 1 },
          "accepts": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "produces": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
